{
  "name": "@stigmer/identity",
  "version": "0.1.0",
  "description": "Shared identity for Stigmer vertical apps: the User resource, credential storage, token issuing/verification, and a pluggable authenticator chain. Owns the seam; ships the smallest correct issuer (DD-005).",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stigmer/stigmer-apps.git",
    "directory": "packages/identity"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./postgres": {
      "types": "./dist/postgres/index.d.ts",
      "default": "./dist/postgres/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "proto",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.13.0",
    "@connectrpc/connect": "^2.1.2",
    "@stigmer/resource-api": "^0.4.0",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.8",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  }
}
